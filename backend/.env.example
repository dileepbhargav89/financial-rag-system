# ─────────────────────────────────────────────────────────────
# Mistral AI — https://console.mistral.ai
# ─────────────────────────────────────────────────────────────
MISTRAL_API_KEY=jFNqYMPJm3WVaDhBtfqmlSQVK7pwKsOd
MISTRAL_MODEL=mistral-large-latest
MISTRAL_EMBED_MODEL=mistral-embed

# Server
PORT=5000
HOST=0.0.0.0
DEBUG=false
FRONTEND_URL=http://localhost:3000

# Paths
VECTORSTORE_PATH=./vectorstore
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=100

# ─────────────────────────────────────────────────────────────
# Embedding batch size — CRITICAL for large PDFs (100+ pages)
# 32 chunks per API call is safe for mistral-embed.
# Do NOT raise above 50 without testing.
# ─────────────────────────────────────────────────────────────
EMBED_BATCH_SIZE=32
EMBED_BATCH_DELAY=0.3

# RAG parameters
TOP_K_RESULTS=6
MMR_LAMBDA=0.6
SCORE_THRESHOLD=0.25
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_CONTEXT_CHARS=6000
